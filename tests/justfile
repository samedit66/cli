# Build with EiffelStudio. Requires ec and ISE_LIBRARY.
eiffelstudio:
    mkdir -p build/eiffelstudio
    GOBO_EIFFEL=ise ec -batch -config parser_checks.ecf -target parser_checks -project_path build/eiffelstudio -freeze -c_compile
    cp build/eiffelstudio/EIFGENs/parser_checks/W_code/parser_checks build/eiffelstudio/parser_checks
    ./build/eiffelstudio/parser_checks

# Build with Gobo. Requires gec and GOBO.
gobo:
    #!/usr/bin/env sh
    set -eu
    mkdir -p build/gobo
    cd build/gobo
    GOBO_EIFFEL=ge gec ../../parser_checks.ecf
    ./parser_checks
