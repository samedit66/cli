# Build with EiffelStudio. Requires ec and ISE_LIBRARY.
eiffelstudio:
    mkdir -p build/eiffelstudio
    GOBO_EIFFEL=ise ec -batch -config greet.ecf -target greet -project_path build/eiffelstudio -freeze -c_compile
    cp build/eiffelstudio/EIFGENs/greet/W_code/greet build/eiffelstudio/greet

# Build with Gobo. Requires gec and GOBO.
gobo:
    #!/usr/bin/env sh
    set -eu
    mkdir -p build/gobo
    cd build/gobo
    GOBO_EIFFEL=ge gec ../../greet.ecf
