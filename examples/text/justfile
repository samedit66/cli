# Build with EiffelStudio. Requires ec and ISE_LIBRARY.
eiffelstudio:
    mkdir -p build/eiffelstudio
    GOBO_EIFFEL=ise ec -batch -config text.ecf -target text -project_path build/eiffelstudio -c_compile
    cp build/eiffelstudio/EIFGENs/text/W_code/text build/eiffelstudio/text

# Build with Gobo. Requires gec and GOBO.
gobo:
    #!/usr/bin/env sh
    set -eu
    mkdir -p build/gobo
    cd build/gobo
    GOBO_EIFFEL=ge gec ../../text.ecf
